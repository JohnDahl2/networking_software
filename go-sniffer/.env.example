# Database connection string
DATABASE_URL=postgres://user:password@localhost:5432/go_sniffer?sslmode=disable

# Worker pool sizes
READER_WORKERS=4
SAVER_WORKERS=2
PRECHECK_WORKERS=2

# Default source directory to scan for pcap files
DEFAULT_SOURCE_DIR=/data/pcaps

# API server address
SERVER_ADDR=:8080
