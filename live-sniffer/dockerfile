# ==========================================
# STAGE 1: Build the Go Application
# ==========================================
FROM golang:1.26-bookworm AS builder

# Install libpcap headers needed to COMPILE gopacket
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpcap-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy shared module first (build context is repo root)
COPY shared/ ./shared/

# Copy live-sniffer and download dependencies
COPY live-sniffer/go.mod live-sniffer/go.sum ./live-sniffer/
RUN cd live-sniffer && go mod download

# Copy the rest of live-sniffer source
COPY live-sniffer/ ./live-sniffer/

# Build from the live-sniffer directory
RUN cd live-sniffer && CGO_ENABLED=1 GOOS=linux go build -ldflags="-w -s" -o ../live ./cmd/live

# ==========================================
# STAGE 2: Lightweight Runtime Environment
# ==========================================
FROM debian:bookworm-slim

# Install ONLY the runtime libpcap library needed to RUN the application
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpcap0.8 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/live .

RUN chmod +x ./live

CMD ["./live", "start"]
